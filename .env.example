# AHARWISE Environment Configuration
#
# AHARWISE runs 100% client-side using static JSON datasets in public/data/
# and browser localStorage. No secret API keys are required to run the app.
# Copy this file to .env if you want to override optional build/runtime settings.

# Optional Vite base path (use '/' for standard root hosting, or '/aharwise/' for GitHub Pages)
VITE_BASE_PATH=/

# Optional default city label shown in the household profile form
VITE_DEFAULT_CITY=Bengaluru
